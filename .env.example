# Provedor de LLM: "groq" (padrão) ou "ollama"
LLM_PROVIDER=groq

# Chave da API do Groq (crie em https://console.groq.com/keys)
GROQ_API_KEY=

# Modelo usado quando LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b

# Modelo usado quando LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:8b

# URL base do servidor Ollama local
OLLAMA_BASE_URL=http://localhost:11434

# Temperatura do modelo (0 = determinístico)
LLM_TEMPERATURE=0.2

# Fixa a "data de hoje" para regras de prazo (AAAA-MM-DD; vazio = hoje)
REFERENCE_DATE=

# Máximo de mensagens mantidas no histórico por conversa
MAX_HISTORY_MESSAGES=20
